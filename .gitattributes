# Windows batch dosyalari cmd.exe tarafindan ayristirilirken LF satir sonu ile
# "goto :etiket" / "call :etiket" cozumlenemiyor. Depoda LF saklanir, calisma
# agacinda her zaman CRLF olur.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scriptler ve kaynak dosyalar LF kalsin.
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
