{
  "name": "community",
  "version": "0.1.0",
  "private": true,
  "description": "Geliştiriciler için aktif topluluk platformu",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:api": "pnpm --filter @community/api dev",
    "dev:web": "pnpm --filter @community/web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @community/api db:generate",
    "db:migrate": "pnpm --filter @community/api db:migrate",
    "db:studio": "pnpm --filter @community/api db:studio"
  }
}